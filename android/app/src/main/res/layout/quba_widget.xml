<?xml version="1.0" encoding="utf-8"?>
<!-- QUBA home-screen widget: next prayer + countdown + Hijri date.
     Dark emerald card (matches the app's dark palette), gold accents.
     All text is single-line with ellipsize so long translations can
     never overflow the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/quba_widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_next_prayer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#F4EFE3"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next_prayer_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#C9A45C"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textColor="#9DB8AB"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="#9DB8AB"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
